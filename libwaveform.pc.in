prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
ffmpeg_flags=@FFMPEG_LDFLAGS@
gtkversion=@GTKVERSION@

Name: Libwaveform
Version: @PACKAGE_VERSION@
Description: Library for displaying audio waveforms
URL: https://github.com/ayyi/libwaveform
Requires: @GTK_PKG@ > @GTKVERSION@.10 libagl
Cflags: -I${includedir} -I${includedir}/gtkglext-@GTKVERSION@.0
Libs: -L${libdir} -lwaveformcore -lwaveformui ${ffmpeg_flags}
